'''
new = '''    /**
     * 必要な枚数に足りるまで、最後のアートボードと同じ大きさのアートボードをグリッド状に追加する
     * カンバス（227×227inch）を外れる位置は Illustrator が受け付けないため、
     * 横一列に伸ばさず NEW_ARTBOARD_COLUMNS 列で折り返す
     * @param {Document} doc - 対象ドキュメント
     * @param {number} requiredCount - 必要なアートボードの枚数
     * @returns {number} 実際に用意できたアートボードの枚数
     */
    function ensureArtboardCount(doc, requiredCount) {
        if (doc.artboards.length >= requiredCount) {
            return doc.artboards.length;
        }
        var originRect = doc.artboards[doc.artboards.length - 1].artboardRect;
        var stepX = (originRect[2] - originRect[0]) + NEW_ARTBOARD_GAP;
        var stepY = (originRect[1] - originRect[3]) + NEW_ARTBOARD_GAP;
        var columnCount = (NEW_ARTBOARD_COLUMNS > 0) ? NEW_ARTBOARD_COLUMNS : requiredCount;
        var addCount = requiredCount - doc.artboards.length;
        for (var i = 1; i <= addCount; i++) {
            var offsetX = (i % columnCount) * stepX;
            var offsetY = Math.floor(i / columnCount) * stepY;
            /* カンバス外の矩形は Error 1200 になるので、そこで打ち切る / Illustrator rejects rects outside the canvas */
            try {
                doc.artboards.add([
                    originRect[0] + offsetX, originRect[1] - offsetY,
                    originRect[2] + offsetX, originRect[3] - offsetY
                ]);
            } catch (err) {
                break;
            }
        }
        return doc.artboards.length;
    }
'''
